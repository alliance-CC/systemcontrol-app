# =========================================================
# ツール管理システム 環境変数サンプル
# 実際の値は .env に記入する（.env は絶対にコミットしない）
# 値の作り方は SETUP.md を参照
# =========================================================

# --- Google Sheets（SETUP.md 手順 2・3）---
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxx@xxxxx.iam.gserviceaccount.com
# private_key は改行を \n にエスケープして 1 行で格納する
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789

# シート（タブ）名。既定値のままでよければ設定不要
SHEET_TAB_MASTER=master
SHEET_TAB_RECORDS=records
SHEET_TAB_USERS=users

# --- シークレット（SETUP.md 手順 4）---
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -base64 32（32文字以上）
SESSION_SECRET=
# openssl rand -hex 32 : /api/patrol と /api/support/sync の保護用
CRON_SECRET=

# --- 現場サポートモード（任意・未設定でもキーワード検索で動作する）---
# Anthropic API キー。設定すると AI による回答生成・依頼文作成が有効になる
ANTHROPIC_API_KEY=
# 使用モデル（未設定なら claude-sonnet-5）
ANTHROPIC_MODEL=claude-sonnet-5

# 参照する GitHub リポジトリ（knowledge/sources.json で指定）を読むためのトークン。
# public リポジトリのみなら未設定でも動くが、レート制限が緩くなるので設定推奨。
# private リポジトリを読む場合は必須（Contents: Read-only の細粒度 PAT を推奨）
GITHUB_TOKEN=

# 開発者への依頼先（依頼文の宛先表示・Issue 起票リンクに使う）
DEV_REQUEST_REPO=alliance-CC/systemcontrol-app
DEV_REQUEST_CONTACT=開発チーム（Slack: #tool-support）
